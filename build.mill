//| mvnDeps:
//| - com.typesafe:config:1.4.2
package build

import mill._, mill.api._, scalalib._, publish._
import build.project.SpinalVersion

object SpinalModuleInfo {
  def apply(crossScalaVersion: String) = (moduleDeps(crossScalaVersion), () => scalacOptions(crossScalaVersion))

  def moduleDeps(crossScalaVersion: String): Map[String, PublishModule] = Map(
    "core"        -> core(crossScalaVersion),
    "lib"         -> lib(crossScalaVersion),
    "sim"         -> sim(crossScalaVersion),
    "idslpayload" -> idslpayload(crossScalaVersion),
    "idslplugin"  -> idslplugin(crossScalaVersion),
    "tester"      -> tester(crossScalaVersion)
  )

  def scalacOptions(crossScalaVersion: String) = idslplugin(crossScalaVersion).pluginOptions
}

trait SpinalModule { this: CrossSpinalModule =>
  def moduleInfo = SpinalModuleInfo(crossScalaVersion)
}

object idslpayload extends Cross[SpinalIdslPayload](SpinalVersion.compilers)
trait SpinalIdslPayload extends IdslPayload with SpinalModule

object idslplugin extends Cross[SpinalIdslPlugin](SpinalVersion.compilers)
trait SpinalIdslPlugin extends IdslPlugin with SpinalModule


object sim extends Cross[SpinalSim](SpinalVersion.compilers){
  def defaultCrossSegments = Seq(SpinalVersion.compilers.head)
}
trait SpinalSim extends Sim with SpinalModule


object lib extends Cross[SpinalLib](SpinalVersion.compilers){
  def defaultCrossSegments = Seq(SpinalVersion.compilers.head)
}
trait SpinalLib extends Lib with SpinalModule


object core extends Cross[SpinalCore](SpinalVersion.compilers){
  def defaultCrossSegments = Seq(SpinalVersion.compilers.head)
}
trait SpinalCore extends Core with SpinalModule


object tester extends Cross[SpinalTester](SpinalVersion.compilers){
  def defaultCrossSegments = Seq(SpinalVersion.compilers.head)
}
trait SpinalTester extends Tester with SpinalModule
